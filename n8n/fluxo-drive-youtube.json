    {
      "parameters": {
        "jsCode": "// Lê o JSON baixado do Drive, valida e separa: pedido para a API + dados do YouTube.\nconst arquivo = $('Buscar JSON pendente').first().json;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst texto = buffer.toString('utf8').replace(/^\\uFEFF/, ''); // remove BOM (arquivos salvos no Windows)\n\nlet dados;\ntry { dados = JSON.parse(texto); }\ncatch (e) { throw new Error('\"' + arquivo.name + '\" não é um JSON válido: ' + e.message); }\n\nconst erros = [];\nif (!dados.roteiro || typeof dados.roteiro !== 'object') erros.push('campo \"roteiro\" ausente');\n\nconst yt = dados.youtube || {};\nconst titulo = String(yt.titulo || '').trim();\nif (!titulo) erros.push('youtube.titulo ausente');\nif (titulo.length > 100) erros.push('youtube.titulo tem ' + titulo.length + ' caracteres (máx. 100)');\nif (/[<>]/.test(titulo)) erros.push('youtube.titulo não pode conter < ou >');\n\nconst hashtags = (Array.isArray(yt.hashtags) ? yt.hashtags : [])\n  .map(h => '#' + String(h).replace(/^#+/, '').replace(/\\s+/g, ''))\n  .filter(h => h.length > 1);\n\nlet descricao = String(yt.descricao || '').trim();\nif (hashtags.length) descricao += (descricao ? '\\n\\n' : '') + hashtags.join(' ');\nif (/[<>]/.test(descricao)) erros.push('youtube.descricao não pode conter < ou >');\nif (Buffer.byteLength(descricao, 'utf8') > 5000) erros.push('youtube.descricao passa de 5000 bytes');\n\nconst tagsBrutas = Array.isArray(yt.tags) ? yt.tags : String(yt.tags || '').split(',');\nconst tags = [...new Set([...tagsBrutas, ...hashtags.map(h => h.slice(1))]\n  .map(t => String(t).replace(/[<>,#]/g, '').trim()).filter(Boolean))];\nif (tags.join(',').length > 500) erros.push('tags somam mais de 500 caracteres');\n\nconst privacidade = yt.privacidade || 'private';\nif (!['private', 'unlisted', 'public'].includes(privacidade)) erros.push('youtube.privacidade deve ser private, unlisted ou public');\nif (typeof yt.paraCriancas !== 'boolean') erros.push('youtube.paraCriancas deve ser true ou false (declaração obrigatória do YouTube)');\n\nif (erros.length) throw new Error('\"' + arquivo.name + '\": ' + erros.join('; '));\n\nconst pedido = {\n  pasta: dados.pasta || arquivo.name.replace(/\\.json$/i, ''),\n  vozes: dados.vozes !== false,\n  versaoSemFalas: !!dados.versaoSemFalas,\n  post: { titulo, descricao, hashtags },   // a API só guarda e devolve isso\n  roteiro: dados.roteiro\n};\n\nreturn [{ json: {\n  arquivoId: arquivo.id,\n  arquivoNome: arquivo.name,\n  pedido,\n  youtube: {\n    titulo, descricao,\n    tags: tags.join(','),\n    categoria: String(yt.categoria || '1'),     // 1 = Filmes e animação, 24 = Entretenimento\n    privacidade,\n    paraCriancas: yt.paraCriancas,\n    notificarInscritos: yt.notificarInscritos !== false\n  }\n} }];"
      },
